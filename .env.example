# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# LLM (pi-ai) — 默认 DeepSeek
PI_PROVIDER=deepseek
PI_MODEL=deepseek-v4-flash
# 可选：覆盖 provider 默认 API 地址（OpenAI 兼容端点）
PI_BASE_URL=https://api.deepseek.com

# API Key（与 PI_PROVIDER 对应）
DEEPSEEK_API_KEY=

# 其他 provider 示例（切换 PI_PROVIDER / PI_MODEL 时使用）
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Frontend
VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:3001
